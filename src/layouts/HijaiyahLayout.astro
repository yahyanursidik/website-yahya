---
import AppHeader from '../components/hijaiyah/AppHeader.astro';
import BottomNav from '../components/hijaiyah/BottomNav.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Aplikasi edukasi Hijaiyah interaktif dan ramah anak" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Hijaiyah Play</title>
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Nunito:wght@400;600;700;800&display=swap');
        </style>
	</head>
	<body class="bg-[#FFFDF7] text-[#0F4C5C] font-['Nunito',sans-serif] min-h-screen pb-20 md:pb-0">
        <AppHeader />
		<main class="max-w-2xl mx-auto min-h-[calc(100vh-80px)]">
			<slot />
		</main>
        <BottomNav />
	</body>
</html>

<style is:global>
	:root {
		--color-cream: #FFFDF7;
		--color-sage: #E3F0E5;
		--color-teal: #0F4C5C;
		--color-sky: #83C5BE;
		--color-yellow: #FFD166;
	}
    
    .font-arabic {
        font-family: 'Amiri', serif;
    }
</style>
