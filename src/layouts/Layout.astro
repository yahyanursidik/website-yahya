---
import '../index.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/vite.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Elfsight Script for Instagram -->
    <script src="https://static.elfsight.com/platform/platform.js" async></script>
    <style is:global>
      .animated-gradient-bg {
          position: fixed;
          top: 0;
          left: 0;
          width: 100vw;
          height: 100vh;
          z-index: -1;
          background: linear-gradient(-45deg, #f9f9f9, rgba(27, 67, 50, 0.08), rgba(1, 45, 29, 0.05), #f9f9f9);
          background-size: 400% 400%;
      }

      /* Animations */
      @media (prefers-reduced-motion: no-preference) {
          @keyframes gradientShift {
              0% { background-position: 0% 50%; }
              50% { background-position: 100% 50%; }
              100% { background-position: 0% 50%; }
          }
          .animated-gradient-bg {
              animation: gradientShift 20s ease infinite;
          }

          .fade-in-up {
              opacity: 0;
              transform: translateY(20px);
              transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
          }
          .fade-in-up.is-visible {
              opacity: 1;
              transform: translateY(0);
          }
          .delay-100 { transition-delay: 100ms; }
          .delay-200 { transition-delay: 200ms; }
          .delay-300 { transition-delay: 300ms; }

          @keyframes float {
              0%, 100% { transform: translateY(0); }
              50% { transform: translateY(-10px); }
          }
          .animate-float {
              animation: float 4s ease-in-out infinite;
          }

          @keyframes pulse-subtle {
              0%, 100% { opacity: 1; }
              50% { opacity: 0.7; }
          }
          .animate-pulse-subtle {
              animation: pulse-subtle 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
          }
      }

      /* Hover Link Animation */
      .hover-line-draw {
          position: relative;
      }
      .hover-line-draw::after {
          content: '';
          position: absolute;
          width: 100%;
          transform: scaleX(0);
          height: 1px;
          bottom: -2px;
          left: 0;
          background-color: currentColor;
          transform-origin: bottom right;
          transition: transform 0.3s ease-out;
      }
      .hover-line-draw:hover::after {
          transform: scaleX(1);
          transform-origin: bottom left;
      }
    </style>
  </head>
  <body class="bg-transparent text-on-surface font-body selection:bg-primary-fixed selection:text-on-primary-fixed">
    <div class="animated-gradient-bg"></div>
    
    <nav class="fixed top-0 w-full z-50 bg-[#f9f9f9]/80 glass-nav">
      <div class="flex justify-between items-center max-w-5xl mx-auto px-8 py-6 w-full">
        <a class="text-[#1a1c1c] font-headline" href="#">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAzAio1PQIwBKTdXXRFHGNk7uSbrZT7sPFSe2OZNH7ontuDbNWzskgYgx-uxquHIRMlI5Llhi4qdcXLqTKSub5sIKdpsSqXAtf8rqIsLp9Z2-DiMGbzbaNanTf7z3Tx7JXL5s7InDpVb2UDg0At8Lqucvelh3_gf2-wV-XR0cH-fSC8BQQMD2y6NkFjxasxTHQZp7cRjcGC9R_g0sCTkGQO34LAP3XVOtWfMKsrv5Cj3HqcoUOjT_SG4S3ZIkXdBZ-210XufdumSRjK" alt="Yahya Nursidik Logo" class="h-10 w-auto object-contain" style="max-height: 40px;">
        </a>
        <div class="hidden md:flex items-center space-x-8 font-body text-sm tracking-wide">
          <a class="text-primary font-medium hover-line-draw" href="/">Beranda</a>
          <a class="text-stone-500 hover:text-primary transition-colors hover-line-draw" href="/#profil">Profil</a>
          <a class="text-stone-500 hover:text-primary transition-colors hover-line-draw" href="#">Kegiatan</a>
          <a class="text-stone-500 hover:text-primary transition-colors hover-line-draw" href="#">Kontak</a>
        </div>
      </div>
    </nav>

    <main class="hero-gradient">
      <slot />
    </main>

    <footer class="bg-surface-container-high py-16 px-8 border-t border-outline-variant/20 scroll-reveal fade-in-up is-visible">
      <div class="max-w-5xl mx-auto flex flex-col md:flex-row justify-between items-center gap-8 text-center md:text-left">
        <div>
          <h3 class="text-lg font-bold text-primary font-headline mb-2">Yahya Nursidik</h3>
          <p class="text-stone-500 text-xs font-body tracking-wide uppercase">Dedikasi untuk Masa Depan Pendidikan Indonesia</p>
          <div class="flex justify-center md:justify-start gap-4 mt-4">
            <a class="text-stone-500 hover:text-primary transition-colors hover-line-draw pb-1" href="https://www.instagram.com/yahyanursidik/" target="_blank" rel="noreferrer">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
            </a>
            <a class="text-stone-500 hover:text-primary transition-colors hover-line-draw pb-1" href="https://www.linkedin.com/in/yahya-nursidik-499aa653/" target="_blank" rel="noreferrer">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path></svg>
            </a>
          </div>
        </div>
        <div class="flex gap-8 text-sm text-stone-500">
          <a class="hover:text-primary transition-colors hover-line-draw pb-1" href="#">Kebijakan Privasi</a>
          <a class="hover:text-primary transition-colors hover-line-draw pb-1" href="#">Media Kit</a>
          <a class="hover:text-primary transition-colors hover-line-draw pb-1" href="#">Kontak</a>
        </div>
      </div>
      <div class="max-w-5xl mx-auto mt-12 pt-8 border-t border-outline-variant/10 text-center">
        <p class="text-stone-400 text-[10px] uppercase tracking-widest">© 2024 Yahya Nursidik. Academic Serenity.</p>
      </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Trigger initial fade-in elements not managed by observer (Hero section)
            setTimeout(() => {
                const heroElements = document.querySelectorAll('.pt-40 .fade-in-up');
                heroElements.forEach(el => el.classList.add('is-visible'));
            }, 100);

            // Intersection Observer for scroll reveals
            const observerOptions = {
                root: null,
                rootMargin: '0px',
                threshold: 0.15
            };

            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        // If the observed element itself has fade-in-up
                        if (entry.target.classList.contains('fade-in-up')) {
                             entry.target.classList.add('is-visible');
                        }
                        
                        // Also trigger any child elements with fade-in-up
                        const children = entry.target.querySelectorAll('.fade-in-up');
                        children.forEach(child => child.classList.add('is-visible'));
                        
                        observer.unobserve(entry.target);
                    }
                });
            }, observerOptions);

            const revealElements = document.querySelectorAll('.scroll-reveal');
            revealElements.forEach(el => observer.observe(el));
        });
    </script>
  </body>
</html>
