---
import '../index.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Ruang untuk mengenal karya, aplikasi pendidikan, tulisan, dan kegiatan Yahya Nursidik.'
} = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;6..72,600&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen antialiased">
    <a class="skip-link" href="#konten" data-i18n-id="Lewati ke konten utama" data-i18n-en="Skip to main content">Lewati ke konten utama</a>

    <header class="site-header" data-header>
      <div class="masthead-main shell flex items-center justify-between gap-6">
        <a href="/" class="group flex items-center gap-3" aria-label="Yahya Nursidik, beranda">
          <span class="grid h-10 w-10 place-items-center rounded-[var(--radius-md)] bg-[var(--color-forest)] font-headline text-lg text-[var(--color-inverse)]">YN</span>
          <span class="leading-tight">
            <strong class="block text-sm font-semibold">Yahya Nursidik</strong>
            <span class="block text-[11px] text-[var(--color-muted)]" data-i18n-id="Catatan karya & pembelajaran" data-i18n-en="Works & learning notes">Catatan karya & pembelajaran</span>
          </span>
        </a>

        <div class="flex items-center gap-2">
          <div class="language-switch" aria-label="Pilihan bahasa">
            <button type="button" data-lang-button="id" aria-pressed="true">ID</button>
            <button type="button" data-lang-button="en" aria-pressed="false">EN</button>
          </div>
          <button class="menu-button lg:hidden" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
            <span class="sr-only" data-i18n-id="Buka menu" data-i18n-en="Open menu">Buka menu</span>
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>

      <div class="masthead-nav hidden lg:block">
        <nav class="masthead-nav-inner shell text-sm" aria-label="Navigasi utama">
          <div class="flex items-center gap-8">
            <a class="nav-link" href="/#karya" data-section-link="karya" data-i18n-id="E-book" data-i18n-en="E-books">E-book</a>
            <a class="nav-link" href="/#sistem" data-section-link="sistem" data-i18n-id="Portofolio digital" data-i18n-en="Digital portfolio">Portofolio digital</a>
            <a class="nav-link" href="/#tulisan" data-section-link="tulisan" data-i18n-id="Tulisan" data-i18n-en="Writing">Tulisan</a>
            <a class="nav-link" href="/#kegiatan" data-section-link="kegiatan" data-i18n-id="Kelas & program" data-i18n-en="Classes & programs">Kelas & program</a>
            <a class="nav-link" href="/#tentang" data-section-link="tentang" data-i18n-id="Tentang" data-i18n-en="About">Tentang</a>
          </div>
          <a class="text-link" href="/#kontak" data-i18n-id="Mulai percakapan" data-i18n-en="Start a conversation">Mulai percakapan</a>
        </nav>
      </div>

      <nav id="mobile-menu" class="mobile-menu lg:hidden" aria-label="Navigasi seluler" data-mobile-menu hidden>
        <div class="shell grid gap-1 py-3">
          <a href="/#karya" data-i18n-id="E-book" data-i18n-en="E-books">E-book</a>
          <a href="/#sistem" data-i18n-id="Sistem & aplikasi" data-i18n-en="Systems & apps">Sistem & aplikasi</a>
          <a href="/#tulisan" data-i18n-id="Tulisan" data-i18n-en="Writing">Tulisan</a>
          <a href="/#kegiatan" data-i18n-id="Kegiatan" data-i18n-en="Programs">Kegiatan</a>
          <a href="/#tentang" data-i18n-id="Tentang" data-i18n-en="About">Tentang</a>
          <a href="/#kontak" data-i18n-id="Hubungi" data-i18n-en="Contact">Hubungi</a>
        </div>
      </nav>
      <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
    </header>

    <main id="konten"><slot /></main>

    <footer class="border-t border-[var(--color-rule)] bg-[var(--color-paper-2)] py-12">
      <div class="shell flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
        <div class="max-w-md">
          <p class="font-headline text-3xl" data-i18n-id="Salam hangat, Yahya." data-i18n-en="Warmly, Yahya.">Salam hangat, Yahya.</p>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]" data-i18n-id="Terima kasih sudah singgah, membaca, dan melihat karya yang masih terus bertumbuh." data-i18n-en="Thank you for visiting, reading, and exploring work that continues to grow.">Terima kasih sudah singgah, membaca, dan melihat karya yang masih terus bertumbuh.</p>
        </div>
        <div class="text-sm text-[var(--color-muted)] sm:text-right">
          <div class="mb-3 flex gap-5 sm:justify-end">
            <a class="footer-link" href="https://www.instagram.com/yahyanursidik/" target="_blank" rel="noreferrer">Instagram</a>
            <a class="footer-link" href="https://www.linkedin.com/in/yahya-nursidik-499aa653/" target="_blank" rel="noreferrer">LinkedIn</a>
          </div>
          <p>© {year} Yahya Nursidik</p>
        </div>
      </div>
    </footer>

    <button class="back-to-top" type="button" data-back-to-top aria-label="Kembali ke atas" title="Kembali ke atas">↑</button>

    <script>
      const button = document.querySelector('[data-menu-button]');
      const menu = document.querySelector('[data-mobile-menu]');

      const closeMenu = () => {
        if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
        button.setAttribute('aria-expanded', 'false');
        button.classList.remove('is-open');
        menu.hidden = true;
      };

      button?.addEventListener('click', () => {
        if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!isOpen));
        button.classList.toggle('is-open', !isOpen);
        menu.hidden = isOpen;
      });

      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.addEventListener('resize', () => { if (window.innerWidth >= 1024) closeMenu(); });

      const languageButtons = document.querySelectorAll('[data-lang-button]');
      const translatableNodes = document.querySelectorAll('[data-i18n-id][data-i18n-en]');
      const setLanguage = (language: string | undefined) => {
        const nextLanguage = language === 'en' ? 'en' : 'id';
        document.documentElement.lang = nextLanguage;
        translatableNodes.forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          node.textContent = node.dataset[nextLanguage === 'en' ? 'i18nEn' : 'i18nId'] || '';
        });
        languageButtons.forEach((node) => {
          if (!(node instanceof HTMLButtonElement)) return;
          const isActive = node.dataset.langButton === nextLanguage;
          node.setAttribute('aria-pressed', String(isActive));
          node.classList.toggle('is-active', isActive);
        });
        try { window.localStorage.setItem('site-language', nextLanguage); } catch {}
        window.dispatchEvent(new CustomEvent('site-language-change', { detail: { language: nextLanguage } }));
      };

      languageButtons.forEach((node) => {
        node.addEventListener('click', () => {
          if (!(node instanceof HTMLButtonElement)) return;
          setLanguage(node.dataset.langButton);
        });
      });

      let savedLanguage = 'id';
      try { savedLanguage = window.localStorage.getItem('site-language') || 'id'; } catch {}
      setLanguage(savedLanguage);

      const progress = document.querySelector('[data-reading-progress]');
      const backToTop = document.querySelector('[data-back-to-top]');
      let scrollFrame: number | undefined;
      const updateScrollUi = () => {
        scrollFrame = undefined;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = scrollable > 0 ? Math.min(window.scrollY / scrollable, 1) : 0;
        if (progress instanceof HTMLElement) progress.style.transform = `scaleX(${ratio})`;
        if (backToTop instanceof HTMLElement) backToTop.classList.toggle('is-visible', window.scrollY > 640);
      };
      window.addEventListener('scroll', () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(updateScrollUi);
      }, { passive: true });
      updateScrollUi();

      backToTop?.addEventListener('click', () => {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
      });

      const observedSections = ['karya', 'sistem', 'tulisan', 'kegiatan', 'tentang']
        .map((id) => document.getElementById(id))
        .filter((section) => section instanceof HTMLElement);
      const sectionLinks = document.querySelectorAll('[data-section-link]');
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible?.target.id) return;
        sectionLinks.forEach((link) => {
          if (!(link instanceof HTMLElement)) return;
          const active = link.dataset.sectionLink === visible.target.id;
          link.classList.toggle('is-active', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-30% 0px -55% 0px', threshold: [0, .2, .5] });
      observedSections.forEach((section) => sectionObserver.observe(section));
    </script>
  </body>
</html>
