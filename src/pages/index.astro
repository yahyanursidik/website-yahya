---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const jadwal = await reader.collections.jadwal.all();
const buku = await reader.collections.buku.all();

const jadwalOrder = [
  'Kelas Guru PAUD Profesional',
  'Kelas Kepala Sekolah PAUD IT Profesional',
  'Kelas Tumbuh Bersama (Ihsanul Adab Parenting Academy)',
  "Program Kaderisasi Guru Al Qur'an Jenjang PAUD - SD"
];
const orderedJadwal = [...jadwal].sort((a, b) => {
  const aIndex = jadwalOrder.indexOf(a.entry.title);
  const bIndex = jadwalOrder.indexOf(b.entry.title);
  return (aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex) - (bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex);
});

const themes = [
  { number: '01', title: 'Keluarga & pengasuhan', copy: 'Rutinitas keluarga, read-aloud, dan cara menemani tumbuh kembang anak dengan lebih sadar.' },
  { number: '02', title: 'Pembelajaran anak', copy: 'Catatan praktis tentang homeschooling PAUD, perkembangan anak, dan pembelajaran yang dekat dengan keseharian.' },
  { number: '03', title: 'Kepemimpinan pendidikan', copy: 'Gagasan untuk guru dan pengelola lembaga mengenai budaya belajar, tata kelola, dan perbaikan bertahap.' }
];

const childrenBooks = [
  {
    title: 'Menjadi Orang Tua yang Bertumbuh Dengan Design Thinking',
    description: 'E-book pengasuhan untuk membantu orang tua merefleksikan proses mendampingi anak melalui empati, ideasi, uji coba, dan perbaikan berkelanjutan di rumah.',
    coverUrl: '/images/books/menjadi-orang-tua-bertumbuh-design-thinking.png',
    downloadUrl: ''
  },
  {
    title: 'E-Book Eksplorasi Tanya-Jawab: Rahasia Menciptakan Obrolan Seru Anak dan Orang Tua di Rumah',
    description: 'Panduan percakapan keluarga yang mengajak orang tua membangun obrolan hangat, terbuka, dan menyenangkan bersama anak dari aktivitas sehari-hari.',
    coverUrl: '/images/books/eksplorasi-tanya-jawab-obrolan-seru.png',
    downloadUrl: ''
  },
  {
    title: 'Menjadi Seorang Laki-Laki Seperti Ayah',
    description: 'Buku cerita anak tentang belajar meneladani kebaikan ayah: kuat hati, bertanggung jawab, dan tumbuh sebagai muslim yang baik.',
    coverUrl: '/images/books/menjadi-laki-laki-seperti-ayah.png',
    downloadUrl: ''
  },
  {
    title: 'Menjadi Seorang Wanita Seperti Ibu',
    description: 'Kisah anak yang belajar menyayangi, bersabar, dan bertanggung jawab melalui keteladanan ibu dalam kehidupan sehari-hari.',
    coverUrl: '/images/books/menjadi-wanita-seperti-ibu.png',
    downloadUrl: ''
  },
  {
    title: 'Sayuran Sehatku',
    description: 'Buku pengenalan berbagai jenis sayuran dan manfaatnya, disusun untuk membantu anak mencintai kebiasaan sehat sejak dini.',
    coverUrl: '/images/books/sayuran-sehatku.png',
    downloadUrl: ''
  },
  {
    title: 'Petualangan STEM Geosains di Rumah',
    description: 'Panduan kegiatan geosains sederhana di rumah agar orang tua dapat menemani anak mengenal bumi, batuan, gunung, peta, dan fenomena alam dengan cara yang menyenangkan.',
    coverUrl: '/images/books/petualangan-stem-geosains-di-rumah.png',
    downloadUrl: ''
  },
  {
    title: 'E-Book Ceklis Kesiapan Masuk Kelas 1 SD/MI',
    description: 'Ceklis praktis untuk membantu orang tua melihat kesiapan anak memasuki kelas 1 SD/MI dari sisi kemandirian, kebiasaan belajar, sosial-emosional, dan rutinitas dasar.',
    coverUrl: '/images/books/ceklis-kesiapan-masuk-kelas-1-sd-mi.png',
    downloadUrl: ''
  },
  {
    title: 'E-Book Hari-Hari Bermakna di Rumah: Panduan Manajemen Keseharian Islami untuk Orang Tua Anak Usia Dini dan SD',
    description: 'Panduan manajemen keseharian Islami agar rutinitas rumah lebih terarah, hangat, dan bernilai ibadah bagi keluarga dengan anak usia dini dan SD.',
    coverUrl: '/images/books/hari-hari-bermakna-di-rumah.png',
    downloadUrl: ''
  },
  {
    title: 'E-Book Ceklis Indikator: Perkembangan Anak Usia 4-5 Tahun',
    description: 'Panduan ringkas untuk membantu orang tua memahami indikator perkembangan anak usia 4-5 tahun melalui ceklis yang mudah digunakan di rumah.',
    coverUrl: '/images/books/ceklis-indikator-perkembangan-anak-usia-4-5-tahun.png',
    downloadUrl: ''
  },
  {
    title: 'Ceklis Indikator: Perkembangan Anak Usia 5-6 Tahun',
    description: 'Ceklis perkembangan anak usia 5-6 tahun untuk membantu orang tua memantau kesiapan, kebiasaan, dan capaian tumbuh kembang secara bertahap.',
    coverUrl: '/images/books/ceklis-indikator-perkembangan-anak-usia-5-6-tahun.png',
    downloadUrl: ''
  },
  {
    title: 'Ceklis Indikator: Perkembangan Anak Usia 2-3 Tahun',
    description: 'Ceklis perkembangan anak usia 2-3 tahun sebagai panduan sederhana bagi orang tua dalam mengamati tumbuh kembang awal anak di rumah.',
    coverUrl: '/images/books/ceklis-indikator-perkembangan-anak-usia-2-3-tahun.png',
    downloadUrl: ''
  }
];

const educationBooks = [
  {
    title: 'Pengelolaan dan Pengembangan Laboratorium Virtual',
    subtitle: 'Pendekatan Praktek Teknologi Pendidikan dan TIK',
    description: 'Buku bersama Prof. Dr. Deni Darmawan, S.Pd., M.Si., MCE., dengan anggota Yahya Nursidik, S.Pd., M.T., dan Dr. Dadi Mulyadi, S.Pd., M.T., tentang pengelolaan laboratorium virtual dalam konteks teknologi pendidikan dan TIK.',
    coverUrl: '/images/books/pengelolaan-pengembangan-laboratorium-virtual.png',
    downloadUrl: ''
  },
  {
    title: 'Menjadi Pemimpin Sekolah Jenjang PAUD yang Menghidupkan, Bukan Sekadar Mengelola',
    subtitle: 'Panduan Bijak untuk Kepala Sekolah dan Yayasan PAUD Islam',
    description: 'Panduan reflektif untuk kepala sekolah dan yayasan PAUD Islam dalam menumbuhkan visi, guru, lingkungan, dan pembelajaran yang lebih hidup serta terarah.',
    coverUrl: '/images/books/pemimpin-paud-yang-menghidupkan.png',
    downloadUrl: ''
  }
];

const systems = [
  {
    label: 'Website lembaga · Sekolah',
    title: 'Website Sekolah Tarbiyah Sunnah Lab School',
    copy: 'Website resmi sekolah untuk memperkenalkan profil, program, informasi penerimaan, serta kanal komunikasi publik Tarbiyah Sunnah Lab School secara lebih tertata dan mudah diakses.',
    link: 'https://tslabschool.sch.id/',
    action: 'Buka website',
    accent: 'WEB',
    external: true
  },
  {
    label: 'Landing page · Informasi',
    title: 'Landing Page Tarbiyah Sunnah Lab School',
    copy: 'Halaman ringkas untuk mengarahkan calon orang tua dan pengunjung pada informasi penting, tautan layanan, serta kebutuhan komunikasi sekolah yang lebih cepat dan praktis.',
    link: 'https://pintas.tslabschool.sch.id/',
    action: 'Buka landing page',
    accent: 'LP',
    external: true
  },
  {
    label: 'Sistem informasi · Sekolah',
    title: 'Sistem Informasi Akademik dan Operasional Sekolah Tarbiyah Sunnah Lab School',
    copy: 'Platform terpadu untuk membantu alur akademik dan operasional sekolah melalui portal orang tua, ekskul, staf, guru, CBT, HRD, sarana-prasarana, dan kebutuhan layanan internal lain yang terus disesuaikan dengan proses lembaga.',
    link: 'https://hub.tslabschool.sch.id/',
    action: 'Kunjungi portal',
    accent: 'TSL',
    external: true
  },
  {
    label: 'Aplikasi web · Publik',
    title: 'Bermain Hijaiyah',
    copy: 'Teman belajar huruf Hijaiyah dasar melalui aktivitas dengar, pilih, dan kenali. Dirancang sebagai alat bantu—bukan pengganti talaqqi bersama guru atau orang tua.',
    link: '/hijaiyah',
    action: 'Buka aplikasi',
    accent: 'أ'
  },
  {
    label: 'Eksperimen · Pendidikan',
    title: 'Permainan Edukasi',
    copy: 'Kumpulan prototipe permainan sederhana untuk membuat sesi belajar terasa lebih aktif dan ramah bagi anak.',
    link: '/permainan',
    action: 'Lihat kumpulan',
    accent: '✦'
  }
];

const writingAreas = [
  { title: 'Pendidikan & sekolah', copy: 'Refleksi mengenai pembelajaran, budaya sekolah, dan praktik baik yang dapat dicoba secara bertahap.' },
  { title: 'Keluarga & tumbuh kembang', copy: 'Tulisan untuk orang tua tentang kebiasaan kecil, pengasuhan, serta proses belajar anak di rumah.' },
  { title: 'Teknologi pembelajaran', copy: 'Catatan dari proses merancang media, LMS, dan sistem digital yang tetap berpihak pada kebutuhan manusia.' }
];
---

<Layout
  title="Yahya Nursidik — Karya, Aplikasi, dan Catatan Pendidikan"
  description="Arsip e-book, sistem dan aplikasi pendidikan, tulisan, serta kegiatan Yahya Nursidik."
>
  <section class="relative overflow-hidden border-b border-[#dce3de]">
    <div class="pointer-events-none absolute -right-28 top-12 h-80 w-80 rounded-full bg-[#dce9dd] blur-3xl"></div>
    <div class="shell relative grid min-h-[calc(100vh-72px)] items-center gap-12 py-20 lg:grid-cols-[1.15fr_.85fr] lg:py-24">
      <div>
        <p class="eyebrow">Ruang karya & pembelajaran</p>
        <h1 class="mt-6 max-w-3xl font-headline text-[clamp(3.3rem,9vw,6.8rem)] leading-[.86] tracking-[-.055em] text-[#173f32]">
          Belajar,<br />membuat,<br /><em class="text-[#a66c22]">berbagi.</em>
        </h1>
        <p class="mt-8 max-w-xl text-base leading-8 text-[#526a61] sm:text-lg">
          Saya Yahya Nursidik. Ruang ini merangkum sebagian e-book, aplikasi, tulisan, dan kegiatan yang lahir dari perjalanan di bidang pendidikan dan teknologi pembelajaran.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="button" href="#karya">Jelajahi karya <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href="#tentang">Mengenal prosesnya</a>
        </div>
      </div>

      <aside class="map-card card relative overflow-hidden p-7 sm:p-9" aria-labelledby="space-map-title">
        <div class="absolute right-0 top-0 h-28 w-28 rounded-bl-[4rem] bg-[#e7c98f]/50"></div>
        <div class="map-grid" aria-hidden="true"></div>
        <p id="space-map-title" class="relative text-xs font-bold uppercase tracking-[.14em] text-[#7a5a26]">Di dalam ruang ini</p>
        <div class="map-menu relative mt-8">
          <svg class="map-route" viewBox="0 0 120 430" fill="none" aria-hidden="true">
            <path class="map-route-shadow" d="M55 24 C18 72 100 102 63 154 C26 205 96 231 55 282 C18 331 78 359 42 408" />
            <path class="map-route-line" d="M55 24 C18 72 100 102 63 154 C26 205 96 231 55 282 C18 331 78 359 42 408" />
            <circle class="map-traveler" r="6">
              <animateMotion dur="7s" repeatCount="indefinite" path="M55 24 C18 72 100 102 63 154 C26 205 96 231 55 282 C18 331 78 359 42 408" />
            </circle>
          </svg>
          <ol class="map-stops">
            <li><a class="map-link" href="#karya"><span class="map-pin"><b>01</b></span><strong>E-book & panduan</strong><i>&rarr;</i></a></li>
            <li><a class="map-link" href="#sistem"><span class="map-pin"><b>02</b></span><strong>Sistem & aplikasi</strong><i>&rarr;</i></a></li>
            <li><a class="map-link" href="#tulisan"><span class="map-pin"><b>03</b></span><strong>Tulisan di berbagai ruang</strong><i>&rarr;</i></a></li>
            <li><a class="map-link" href="#kegiatan"><span class="map-pin"><b>04</b></span><strong>Kelas & kegiatan</strong><i>&rarr;</i></a></li>
          </ol>
        </div>
        <p class="relative mt-7 text-xs leading-5 text-[#71837c]">Empat jalur utama untuk membaca karya, mencoba aplikasi, mengikuti tulisan, dan melihat kegiatan.</p>
      </aside>
    </div>
  </section>

  <section id="karya" class="shell py-24 lg:py-32">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow">E-book & panduan</p>
        <h2 class="section-title">Gagasan yang dirapikan agar lebih mudah dipraktikkan.</h2>
      </div>
      <p class="section-copy lg:max-w-sm">Bukan jawaban yang serba selesai, melainkan teman berpikir bagi orang tua, guru, dan pengelola pendidikan.</p>
    </div>

    <div class="mt-12">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <span class="tag">Keluarga & anak</span>
          <h3 class="mt-4 text-3xl leading-tight text-[#173f32]">Bacaan sederhana untuk menemani keluarga bertumbuh.</h3>
        </div>
        <p class="max-w-md text-sm leading-6 text-[#71837c]">Tautan unduh PDF akan ditambahkan setelah file final siap dibagikan.</p>
      </div>
      <div class="mt-7 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {childrenBooks.map((item) => (
          <article class="card group flex h-full flex-col overflow-hidden">
            <div class="aspect-[16/9] overflow-hidden bg-[#e8eee9]">
              <img src={item.coverUrl} alt={`Sampul buku ${item.title}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <span class="tag">E-book keluarga</span>
              <h4 class="mt-4 text-2xl leading-tight">{item.title}</h4>
              <p class="mt-3 flex-1 text-sm leading-6 text-[#61756d]">{item.description}</p>
              {item.downloadUrl ? (
                <a class="button button-small mt-5 w-full" href={item.downloadUrl} target="_blank" rel="noreferrer">Download PDF</a>
              ) : (
                <span class="mt-5 inline-flex min-h-10 w-full items-center justify-center rounded-full border border-[#dce3de] px-4 py-2 text-center text-xs font-bold uppercase tracking-[.08em] text-[#71837c]">PDF segera tersedia</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>

    {buku.length > 0 ? (
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {buku.map((item) => (
          <article class="card group overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-[#e8eee9]">
              <img src={item.entry.coverUrl} alt={`Sampul ${item.entry.title}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="p-6">
              <span class="tag">E-book</span>
              <h3 class="mt-4 text-2xl leading-tight">{item.entry.title}</h3>
              <p class="mt-3 text-sm leading-6 text-[#61756d]">{item.entry.description}</p>
              {item.entry.link && <a class="text-link mt-5" href={item.entry.link} target="_blank" rel="noreferrer">Lihat detail</a>}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {themes.map((item) => (
          <article class="card p-6 sm:p-7">
            <span class="font-headline text-3xl text-[#bd8a3e]">{item.number}</span>
            <h3 class="mt-10 text-2xl">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[#61756d]">{item.copy}</p>
          </article>
        ))}
      </div>
    )}
    <p class="mt-7 max-w-2xl text-sm leading-6 text-[#71837c]">Katalog lengkap dan tautan baca sedang dirapikan. Untuk sementara, tema-tema di atas menggambarkan arah karya yang tersedia.</p>

    <div class="mt-14">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <span class="tag">E-book pendidikan</span>
          <h3 class="mt-4 text-3xl leading-tight text-[#173f32]">Bacaan akademis, panduan lembaga, dan profesionalitas.</h3>
        </div>
        <p class="max-w-md text-sm leading-6 text-[#71837c]">Kategori ini memuat bahan bacaan akademis, tata kelola lembaga, kepemimpinan pendidikan, dan penguatan profesionalitas pengelola sekolah.</p>
      </div>
      <div class="mt-7 grid gap-6 md:grid-cols-2">
        {educationBooks.map((item) => (
          <article class="card group flex h-full flex-col overflow-hidden lg:flex-row">
            <div class="aspect-[3/4] overflow-hidden bg-[#e8eee9] lg:w-[42%]">
              <img src={item.coverUrl} alt={`Sampul e-book ${item.title}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <span class="tag">Pendidikan</span>
              <h4 class="mt-4 text-2xl leading-tight">{item.title}</h4>
              <p class="mt-2 text-sm font-semibold leading-6 text-[#a66c22]">{item.subtitle}</p>
              <p class="mt-3 flex-1 text-sm leading-6 text-[#61756d]">{item.description}</p>
              {item.downloadUrl ? (
                <a class="button button-small mt-5 w-full" href={item.downloadUrl} target="_blank" rel="noreferrer">Download PDF</a>
              ) : (
                <span class="mt-5 inline-flex min-h-10 w-full items-center justify-center rounded-full border border-[#dce3de] px-4 py-2 text-center text-xs font-bold uppercase tracking-[.08em] text-[#71837c]">PDF segera tersedia</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="sistem" class="bg-[#183d31] py-24 text-white lg:py-32">
    <div class="shell">
      <div class="grid gap-8 lg:grid-cols-[1fr_.7fr] lg:items-end">
        <div>
          <p class="eyebrow !text-[#edc986]">Sistem & aplikasi</p>
          <h2 class="mt-4 max-w-3xl font-headline text-[clamp(2.6rem,6vw,4.8rem)] leading-[.95] tracking-[-.04em]">Teknologi yang membantu proses belajar, bukan mengambil alihnya.</h2>
        </div>
        <p class="leading-7 text-[#bfd0c7]">Pilihan produk publik dan eksperimen digital. Beberapa sistem internal tidak ditampilkan untuk menjaga konteks serta kerahasiaan lembaga.</p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {systems.map((item) => (
          <article class="group rounded-[1.5rem] border border-white/15 bg-white/[.06] p-7 transition-colors hover:bg-white/[.1] sm:p-9">
            <div class="flex items-start justify-between gap-5">
              <span class="text-xs font-bold uppercase tracking-[.12em] text-[#edc986]">{item.label}</span>
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[#f5e3bd] font-headline text-3xl text-[#173f32]">{item.accent}</span>
            </div>
            <h3 class="mt-14 text-3xl">{item.title}</h3>
            <p class="mt-4 max-w-lg text-sm leading-7 text-[#c7d5ce]">{item.copy}</p>
            <a class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-white" href={item.link} target={item.external ? '_blank' : undefined} rel={item.external ? 'noreferrer' : undefined}>{item.action} <span class="transition-transform group-hover:translate-x-1">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="tulisan" class="shell py-24 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Tulisan & kontribusi</p>
        <h2 class="section-title">Menulis untuk memperpanjang percakapan.</h2>
        <p class="section-copy">Sebagian tulisan pernah hadir di kolom blog lembaga dan ruang kolaboratif. Arsip nama lembaga beserta tautan artikelnya sedang disusun agar setiap rujukan dapat ditampilkan dengan tepat.</p>
        <a class="text-link mt-6" href="https://www.linkedin.com/in/yahya-nursidik-499aa653/" target="_blank" rel="noreferrer">Ikuti catatan terbaru</a>
      </div>
      <div class="divide-y divide-[#dce3de] border-y border-[#dce3de]">
        {writingAreas.map((item, index) => (
          <article class="grid gap-3 py-7 sm:grid-cols-[3rem_1fr] sm:gap-5">
            <span class="font-headline text-2xl text-[#bd8a3e]">0{index + 1}</span>
            <div>
              <h3 class="text-2xl">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[#61756d]">{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="kegiatan" class="border-y border-[#dce3de] bg-[#eef1ec] py-24 lg:py-28">
    <div class="shell">
      <div>
        <p class="eyebrow">Kelas & kegiatan</p>
        <h2 class="section-title">Ruang belajar yang sedang berjalan.</h2>
      </div>
      {orderedJadwal.length > 0 ? (
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {orderedJadwal.map((item) => (
            <article class="card flex h-full flex-col p-6">
              <div class="flex flex-wrap items-center justify-between gap-3"><span class="tag">{item.entry.type}</span><span class="text-xs text-[#71837c]">{item.entry.format}</span></div>
              <h3 class="mt-6 text-2xl leading-tight">{item.entry.title}</h3>
              {item.entry.description && <p class="mt-3 flex-1 text-sm leading-6 text-[#61756d]">{item.entry.description}</p>}
              <p class="mt-6 border-t border-[#dce3de] pt-4 text-xs font-semibold text-[#526a61]">{item.entry.status}</p>
              {item.entry.link && <a class="button button-small mt-5 w-full" href={item.entry.link} target="_blank" rel="noreferrer">Lihat informasi</a>}
            </article>
          ))}
        </div>
      ) : (
        <div class="card mt-10 flex flex-col justify-between gap-6 p-7 sm:flex-row sm:items-center">
