        <div class="map-grid" aria-hidden="true"></div>
        <p id="space-map-title" class="relative text-xs font-bold uppercase tracking-[.14em] text-[#7a5a26]" data-i18n-id="Di dalam ruang ini" data-i18n-en="Inside this space">Di dalam ruang ini</p>
