---
import Layout from '../layouts/Layout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

const reader = createReader(process.cwd(), keystaticConfig);
const jadwal = await reader.collections.jadwal.all();
const buku = await reader.collections.buku.all();

const themes = [
  { number: '01', title: 'Keluarga & pengasuhan', copy: 'Rutinitas keluarga, read-aloud, dan cara menemani tumbuh kembang anak dengan lebih sadar.' },
  { number: '02', title: 'Pembelajaran anak', copy: 'Catatan praktis tentang homeschooling PAUD, perkembangan anak, dan pembelajaran yang dekat dengan keseharian.' },
  { number: '03', title: 'Kepemimpinan pendidikan', copy: 'Gagasan untuk guru dan pengelola lembaga mengenai budaya belajar, tata kelola, dan perbaikan bertahap.' }
];

const systems = [
  {
    label: 'Aplikasi web · Publik',
    title: 'Bermain Hijaiyah',
    copy: 'Teman belajar huruf Hijaiyah dasar melalui aktivitas dengar, pilih, dan kenali. Dirancang sebagai alat bantu—bukan pengganti talaqqi bersama guru atau orang tua.',
    link: '/hijaiyah',
    action: 'Buka aplikasi',
    accent: 'أ'
  },
  {
    label: 'Eksperimen · Pendidikan',
    title: 'Permainan Edukasi',
    copy: 'Kumpulan prototipe permainan sederhana untuk membuat sesi belajar terasa lebih aktif dan ramah bagi anak.',
    link: '/permainan',
    action: 'Lihat kumpulan',
    accent: '✦'
  }
];

const writingAreas = [
  { title: 'Pendidikan & sekolah', copy: 'Refleksi mengenai pembelajaran, budaya sekolah, dan praktik baik yang dapat dicoba secara bertahap.' },
  { title: 'Keluarga & tumbuh kembang', copy: 'Tulisan untuk orang tua tentang kebiasaan kecil, pengasuhan, serta proses belajar anak di rumah.' },
  { title: 'Teknologi pembelajaran', copy: 'Catatan dari proses merancang media, LMS, dan sistem digital yang tetap berpihak pada kebutuhan manusia.' }
];
---

<Layout
  title="Yahya Nursidik — Karya, Aplikasi, dan Catatan Pendidikan"
  description="Arsip e-book, sistem dan aplikasi pendidikan, tulisan, serta kegiatan Yahya Nursidik."
>
  <section class="relative overflow-hidden border-b border-[#dce3de]">
    <div class="pointer-events-none absolute -right-28 top-12 h-80 w-80 rounded-full bg-[#dce9dd] blur-3xl"></div>
    <div class="shell relative grid min-h-[calc(100vh-72px)] items-center gap-12 py-20 lg:grid-cols-[1.15fr_.85fr] lg:py-24">
      <div>
        <p class="eyebrow">Ruang karya & pembelajaran</p>
        <h1 class="mt-6 max-w-3xl font-headline text-[clamp(3.3rem,9vw,6.8rem)] leading-[.86] tracking-[-.055em] text-[#173f32]">
          Belajar,<br />membuat,<br /><em class="text-[#a66c22]">berbagi.</em>
        </h1>
        <p class="mt-8 max-w-xl text-base leading-8 text-[#526a61] sm:text-lg">
          Saya Yahya Nursidik. Ruang ini merangkum sebagian e-book, aplikasi, tulisan, dan kegiatan yang lahir dari perjalanan di bidang pendidikan dan teknologi pembelajaran.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a class="button" href="#karya">Jelajahi karya <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href="#tentang">Mengenal prosesnya</a>
        </div>
      </div>

      <aside class="card relative overflow-hidden p-7 sm:p-9" aria-label="Isi utama website">
        <div class="absolute right-0 top-0 h-24 w-24 rounded-bl-[4rem] bg-[#e7c98f]/50"></div>
        <p class="text-xs font-bold uppercase tracking-[.14em] text-[#7a5a26]">Di dalam ruang ini</p>
        <ol class="mt-8 divide-y divide-[#dce3de]">
          <li><a class="overview-link" href="#karya"><span>01</span><strong>E-book & panduan</strong><i>→</i></a></li>
          <li><a class="overview-link" href="#sistem"><span>02</span><strong>Sistem & aplikasi</strong><i>→</i></a></li>
          <li><a class="overview-link" href="#tulisan"><span>03</span><strong>Tulisan di berbagai ruang</strong><i>→</i></a></li>
          <li><a class="overview-link" href="#kegiatan"><span>04</span><strong>Kelas & kegiatan</strong><i>→</i></a></li>
        </ol>
        <p class="mt-7 text-xs leading-5 text-[#71837c]">Disusun agar pembaca dapat langsung menuju hal yang sedang dicari.</p>
      </aside>
    </div>
  </section>

  <section id="karya" class="shell py-24 lg:py-32">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div>
        <p class="eyebrow">E-book & panduan</p>
        <h2 class="section-title">Gagasan yang dirapikan agar lebih mudah dipraktikkan.</h2>
      </div>
      <p class="section-copy lg:max-w-sm">Bukan jawaban yang serba selesai, melainkan teman berpikir bagi orang tua, guru, dan pengelola pendidikan.</p>
    </div>

    {buku.length > 0 ? (
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {buku.map((item) => (
          <article class="card group overflow-hidden">
            <div class="aspect-[4/3] overflow-hidden bg-[#e8eee9]">
              <img src={item.entry.coverUrl} alt={`Sampul ${item.entry.title}`} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
            </div>
            <div class="p-6">
              <span class="tag">E-book</span>
              <h3 class="mt-4 text-2xl leading-tight">{item.entry.title}</h3>
              <p class="mt-3 text-sm leading-6 text-[#61756d]">{item.entry.description}</p>
              {item.entry.link && <a class="text-link mt-5" href={item.entry.link} target="_blank" rel="noreferrer">Lihat detail</a>}
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {themes.map((item) => (
          <article class="card p-6 sm:p-7">
            <span class="font-headline text-3xl text-[#bd8a3e]">{item.number}</span>
            <h3 class="mt-10 text-2xl">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[#61756d]">{item.copy}</p>
          </article>
        ))}
      </div>
    )}
    <p class="mt-7 max-w-2xl text-sm leading-6 text-[#71837c]">Katalog lengkap dan tautan baca sedang dirapikan. Untuk sementara, tema-tema di atas menggambarkan arah karya yang tersedia.</p>
  </section>

  <section id="sistem" class="bg-[#183d31] py-24 text-white lg:py-32">
    <div class="shell">
      <div class="grid gap-8 lg:grid-cols-[1fr_.7fr] lg:items-end">
        <div>
          <p class="eyebrow !text-[#edc986]">Sistem & aplikasi</p>
          <h2 class="mt-4 max-w-3xl font-headline text-[clamp(2.6rem,6vw,4.8rem)] leading-[.95] tracking-[-.04em]">Teknologi yang membantu proses belajar, bukan mengambil alihnya.</h2>
        </div>
        <p class="leading-7 text-[#bfd0c7]">Pilihan produk publik dan eksperimen digital. Beberapa sistem internal tidak ditampilkan untuk menjaga konteks serta kerahasiaan lembaga.</p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {systems.map((item) => (
          <article class="group rounded-[1.5rem] border border-white/15 bg-white/[.06] p-7 transition-colors hover:bg-white/[.1] sm:p-9">
            <div class="flex items-start justify-between gap-5">
              <span class="text-xs font-bold uppercase tracking-[.12em] text-[#edc986]">{item.label}</span>
              <span class="grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-[#f5e3bd] font-headline text-3xl text-[#173f32]">{item.accent}</span>
            </div>
            <h3 class="mt-14 text-3xl">{item.title}</h3>
            <p class="mt-4 max-w-lg text-sm leading-7 text-[#c7d5ce]">{item.copy}</p>
            <a class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-white" href={item.link}>{item.action} <span class="transition-transform group-hover:translate-x-1">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="tulisan" class="shell py-24 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="eyebrow">Tulisan & kontribusi</p>
        <h2 class="section-title">Menulis untuk memperpanjang percakapan.</h2>
        <p class="section-copy">Sebagian tulisan pernah hadir di kolom blog lembaga dan ruang kolaboratif. Arsip nama lembaga beserta tautan artikelnya sedang disusun agar setiap rujukan dapat ditampilkan dengan tepat.</p>
        <a class="text-link mt-6" href="https://www.linkedin.com/in/yahya-nursidik-499aa653/" target="_blank" rel="noreferrer">Ikuti catatan terbaru</a>
      </div>
      <div class="divide-y divide-[#dce3de] border-y border-[#dce3de]">
        {writingAreas.map((item, index) => (
          <article class="grid gap-3 py-7 sm:grid-cols-[3rem_1fr] sm:gap-5">
            <span class="font-headline text-2xl text-[#bd8a3e]">0{index + 1}</span>
            <div>
              <h3 class="text-2xl">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-[#61756d]">{item.copy}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="kegiatan" class="border-y border-[#dce3de] bg-[#eef1ec] py-24 lg:py-28">
    <div class="shell">
      <div>
        <p class="eyebrow">Kelas & kegiatan</p>
        <h2 class="section-title">Ruang belajar yang sedang berjalan.</h2>
      </div>
      {jadwal.length > 0 ? (
        <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {jadwal.map((item) => (
            <article class="card flex h-full flex-col p-6">
              <div class="flex flex-wrap items-center justify-between gap-3"><span class="tag">{item.entry.type}</span><span class="text-xs text-[#71837c]">{item.entry.format}</span></div>
              <h3 class="mt-6 text-2xl leading-tight">{item.entry.title}</h3>
              {item.entry.description && <p class="mt-3 flex-1 text-sm leading-6 text-[#61756d]">{item.entry.description}</p>}
              <p class="mt-6 border-t border-[#dce3de] pt-4 text-xs font-semibold text-[#526a61]">{item.entry.status}</p>
              {item.entry.link && <a class="button button-small mt-5 w-full" href={item.entry.link} target="_blank" rel="noreferrer">Lihat informasi</a>}
            </article>
          ))}
        </div>
      ) : (
        <div class="card mt-10 flex flex-col justify-between gap-6 p-7 sm:flex-row sm:items-center">
          <div><h3 class="text-2xl">Belum ada jadwal publik saat ini.</h3><p class="mt-2 text-sm text-[#61756d]">Informasi kelas atau seminar berikutnya akan ditampilkan di bagian ini.</p></div>
          <a class="button button-secondary shrink-0" href="#kontak">Tanyakan kegiatan</a>
        </div>
      )}
    </div>
  </section>

  <section id="tentang" class="shell py-24 lg:py-32">
    <div class="grid gap-12 lg:grid-cols-[.65fr_1.35fr]">
      <div>
        <p class="eyebrow">Tentang</p>
        <p class="mt-5 font-headline text-4xl leading-tight">Bekerja di antara pendidikan, teknologi, dan pengembangan lembaga.</p>
      </div>
      <div class="space-y-6 text-base leading-8 text-[#526a61] sm:text-lg">
        <p>Perjalanan saya bermula dari teknologi pendidikan dan teknologi informasi, lalu bertumbuh melalui peran sebagai pengajar, pengembang sistem dan media belajar, serta pendamping sejumlah program pendidikan.</p>
        <p>Belakangan, perhatian banyak tertuju pada pendidikan Islam, pembelajaran Al-Qur'an, pendidikan anak, penguatan guru dan orang tua, serta perancangan sistem digital yang lebih sederhana dan manusiawi.</p>
        <blockquote class="border-l-2 border-[#bd8a3e] pl-6 font-headline text-2xl leading-relaxed text-[#173f32]">Yang dibagikan di sini adalah catatan dari proses—terbuka untuk diperbaiki, diperkaya, dan dipelajari kembali.</blockquote>
      </div>
    </div>
  </section>

  <section id="kontak" class="shell pb-24 lg:pb-32">
    <div class="relative overflow-hidden rounded-[2rem] bg-[#e7c98f] p-8 sm:p-12 lg:p-16">
      <div class="absolute -right-10 -top-20 h-64 w-64 rounded-full border-[40px] border-white/20"></div>
      <div class="relative max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[.14em] text-[#694919]">Mari bertukar pikiran</p>
        <h2 class="mt-4 font-headline text-[clamp(2.5rem,6vw,4.5rem)] leading-[.95] tracking-[-.04em]">Ada gagasan yang ingin dibicarakan?</h2>
        <p class="mt-5 max-w-xl leading-7 text-[#60481f]">Silakan menyapa untuk diskusi, kolaborasi pendidikan, pengembangan sistem pembelajaran, atau sekadar bertukar catatan.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="button" href="https://www.instagram.com/yahyanursidik/" target="_blank" rel="noreferrer">Hubungi lewat Instagram</a>
          <a class="button button-secondary !border-[#80612d]" href="https://www.linkedin.com/in/yahya-nursidik-499aa653/" target="_blank" rel="noreferrer">Terhubung di LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .overview-link { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: 1rem; padding: 1rem 0; }
    .overview-link span { color: #a66c22; font-family: 'Newsreader', serif; font-size: 1.15rem; }
    .overview-link strong { font-size: .95rem; font-weight: 600; }
    .overview-link i { font-style: normal; transition: transform .2s ease; }
    .overview-link:hover i { transform: translateX(4px); }
  </style>
</Layout>
