---
import HijaiyahLayout from '../../layouts/HijaiyahLayout.astro';
---

<HijaiyahLayout title="Panduan Orang Tua">
    <div class="px-4 py-8 max-w-2xl mx-auto space-y-6">
        
        <!-- Card 1: Header / Main -->
        <div class="bg-[#FDF8F0] rounded-[2rem] p-6 md:p-8 border border-[#E5E0D8] shadow-[4px_4px_0px_#114D4D] relative overflow-hidden">
            <div class="flex items-start gap-4">
                <div class="mt-1">
                    <svg class="w-8 h-8 text-[#114D4D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-2xl md:text-3xl font-bold text-[#114D4D] mb-3">Panduan Pendampingan</h1>
                    <p class="text-[#114D4D]/80 md:text-lg leading-relaxed">
                        Membangun kecintaan anak pada huruf Hijaiyah melalui pendekatan yang lembut dan sabar.
                    </p>
                </div>
            </div>
        </div>

        <!-- Card 2: Catatan Penting -->
        <div class="bg-[#FFEBEB] rounded-[1.5rem] p-6 border-l-[6px] border-[#D92D20]">
            <div class="flex items-center gap-3 mb-2">
                <svg class="w-5 h-5 text-[#D92D20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h3 class="font-bold text-[#D92D20]">Catatan Penting</h3>
            </div>
            <p class="text-[#B42318] text-sm md:text-base leading-relaxed pl-8">
                Game ini adalah alat bantu interaktif untuk mengenalkan bentuk huruf dan letak pelafalan, <strong>bukan pengganti metode talaqqi (belajar tatap muka) dengan guru Al-Qur'an.</strong>
            </p>
        </div>

        <!-- Grid Cards 3 & 4 -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Card 3: Cara Mendampingi -->
            <div class="bg-[#F0F9FF] rounded-[2rem] p-6 border border-[#BDE0FE] shadow-[2px_2px_0px_#BDE0FE]">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-full bg-[#BDE0FE] text-[#0284C7] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                        </svg>
                    </div>
                    <h3 class="font-bold text-[#0284C7] text-lg">Cara Mendampingi Anak</h3>
                </div>
                
                <ul class="space-y-4">
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-[#0284C7] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-sm text-[#0F4C5C]/80 leading-relaxed">Dampingi anak saat bermain, jadikan momen ini interaktif.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-[#0284C7] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-sm text-[#0F4C5C]/80 leading-relaxed">Ucapkan huruf bersama-sama dengan suara yang jelas.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-[#0284C7] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        <span class="text-sm text-[#0F4C5C]/80 leading-relaxed">Berikan pujian hangat setiap kali anak berhasil.</span>
                    </li>
                </ul>
            </div>

            <!-- Card 4: Durasi Belajar -->
            <div class="bg-[#FFFBEA] rounded-[2rem] p-6 border border-[#FFD166] shadow-[2px_2px_0px_#FFD166] flex flex-col">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-full bg-[#FFD166] text-[#B45309] flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="font-bold text-[#B45309] text-lg">Durasi Belajar Ideal</h3>
                </div>
                
                <div class="bg-white rounded-2xl p-5 border border-[#E5E7EB] text-center flex-1 flex flex-col justify-center">
                    <div class="text-2xl font-bold text-[#114D4D] mb-2">10 - 15 Menit</div>
                    <p class="text-sm text-[#0F4C5C]/70 leading-relaxed">
                        Per sesi. Fokus pada kualitas pengenalan, bukan kuantitas. Berhenti sebelum anak merasa bosan.
                    </p>
                </div>
            </div>

        </div>

        <!-- Card 5: Cara Mengoreksi -->
        <div class="bg-[#F2FBFA] rounded-[2rem] p-6 md:p-8 border border-[#B5E4DF] shadow-[2px_2px_0px_#114D4D]">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-10 h-10 rounded-full bg-[#114D4D] text-white flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                </div>
                <h3 class="font-bold text-[#114D4D] text-lg md:text-xl">Cara Mengoreksi Bacaan</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h4 class="font-bold text-[#114D4D] flex items-center gap-2 mb-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                        </svg>
                        Hindari Menyalahkan
                    </h4>
                    <p class="text-sm text-[#0F4C5C]/80 leading-relaxed pl-6">
                        Jika anak salah menyebut, jangan berkata "Salah!". Cukup ulang pelafalan yang benar sambil tersenyum.
                    </p>
                </div>
                <div>
                    <h4 class="font-bold text-[#114D4D] flex items-center gap-2 mb-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Beri Contoh Visual
                    </h4>
                    <p class="text-sm text-[#0F4C5C]/80 leading-relaxed pl-6">
                        Tunjuk bentuk huruf yang mirip untuk membandingkan, lalu minta anak menirukan gerak bibir Anda.
                    </p>
                </div>
            </div>
        </div>

        <!-- Card 6: Checklist -->
        <div class="bg-[#F5F2E9] rounded-[2rem] p-6 md:p-8 border border-[#E5E0D8]">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                <div class="flex items-center gap-3">
                    <svg class="w-6 h-6 text-[#114D4D]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
                    </svg>
                    <h3 class="font-bold text-[#114D4D] text-lg md:text-xl">Checklist Penguasaan (Level Awal)</h3>
                </div>
                <button class="bg-[#38666A] hover:bg-[#2A4D50] text-white px-5 py-2 rounded-full text-sm font-bold flex items-center justify-center gap-2 shadow-sm transition-colors w-full sm:w-auto">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                    </svg>
                    Cetak
                </button>
            </div>

            <div class="space-y-3">
                <div class="bg-white rounded-full p-3 px-5 flex items-center gap-4 border border-[#E5E0D8]">
                    <div class="w-5 h-5 rounded-md border-2 border-gray-300 flex-shrink-0"></div>
                    <span class="text-sm md:text-base text-[#114D4D]">Mampu membedakan bentuk Alif, Ba, Ta, Tsa</span>
                </div>
                <div class="bg-white rounded-full p-3 px-5 flex items-center gap-4 border border-[#E5E0D8]">
                    <div class="w-5 h-5 rounded-md border-2 border-gray-300 flex-shrink-0"></div>
                    <span class="text-sm md:text-base text-[#114D4D]">Mampu menunjuk huruf saat mendengarkan suara (Listening)</span>
                </div>
                <div class="bg-white rounded-full p-3 px-5 flex items-center gap-4 border border-[#E5E0D8]">
                    <div class="w-5 h-5 rounded-md border-2 border-gray-300 flex-shrink-0"></div>
                    <span class="text-sm md:text-base text-[#114D4D]">Bisa melafalkan huruf tanpa bantuan visual</span>
                </div>
            </div>
        </div>

    </div>
</HijaiyahLayout>
