---
import HijaiyahLayout from '../../../layouts/HijaiyahLayout.astro';
import LevelCard from '../../../components/hijaiyah/LevelCard.astro';
import { getCollection } from 'astro:content';

const levels = await getCollection('hijaiyahLevels');
const sortedLevels = levels.sort((a, b) => a.data.levelNumber - b.data.levelNumber);
---

<HijaiyahLayout title="Pilih Level Belajar">
    <div class="min-h-screen relative overflow-hidden bg-[#FFF9EB]">
        <!-- Background Pattern -->
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none" style="background-image: radial-gradient(#D6A13B 1px, transparent 1px); background-size: 32px 32px;"></div>
        
        <!-- Cloud Decoration Top Left -->
        <div class="absolute top-12 left-10 opacity-70 pointer-events-none hidden md:block">
            <svg width="60" height="30" viewBox="0 0 40 20" fill="#A8DADC" xmlns="http://www.w3.org/2000/svg">
                <circle cx="10" cy="10" r="10"/>
                <circle cx="20" cy="8" r="12"/>
                <circle cx="30" cy="12" r="8"/>
            </svg>
        </div>

        <div class="relative z-10 px-4 py-12 md:py-16 max-w-5xl mx-auto">
            <h1 class="text-3xl md:text-4xl font-bold text-[#114D4D] mb-3 text-center">Pilih Level Belajar</h1>
            <p class="text-center text-[#114D4D]/70 mb-12 max-w-md mx-auto text-lg">
                Mari mulai petualangan seru mengenal huruf Hijaiyah!
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
                {sortedLevels.map((level) => {
                    // Hardcoding progress simulation matching the mockup
                    let status: 'completed' | 'in-progress' | 'locked' | 'special' = 'locked';
                    let progress = 0;
                    
                    if (level.data.levelNumber === 1) {
                        status = 'completed';
                        progress = 100;
                    } else if (level.data.levelNumber === 2) {
                        status = 'in-progress';
                        progress = 40;
                    } else if (level.data.levelNumber === 7) {
                        status = 'special';
                    }

                    const icons = ['ا', 'ج', 'ر', 'ط', 'ك', 'و', 'ي'];
                    const arabicIcon = icons[level.data.levelNumber - 1] || 'ا';

                    return (
                        <div class={level.data.levelNumber === 7 ? 'col-span-full mt-4' : 'h-full'}>
                            <LevelCard 
                                slug={level.id}
                                levelNumber={level.data.levelNumber}
                                title={level.data.title}
                                description={level.data.description}
                                status={status}
                                progress={progress}
                                arabicIcon={arabicIcon}
                            />
                        </div>
                    );
                })}
                
                {levels.length === 0 && (
                    <div class="col-span-full text-center p-8 bg-[#EBE5D9]/50 rounded-3xl border border-dashed border-[#E0D8C8]">
                        <p class="text-[#8F9B9B]">Belum ada level tersedia.</p>
                    </div>
                )}
            </div>
        </div>
    </div>
</HijaiyahLayout>
