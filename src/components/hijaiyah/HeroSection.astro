<div class="bg-[#E3F0E5] rounded-3xl p-8 text-center mt-8 mx-4 shadow-sm border border-[#83C5BE]/20 relative overflow-hidden">
    <!-- Decorative background blobs (abstract, not objects/animals) -->
    <div class="absolute top-0 right-0 -mt-10 -mr-10 w-32 h-32 bg-[#FFD166] rounded-full opacity-20 blur-2xl"></div>
    <div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-[#83C5BE] rounded-full opacity-20 blur-2xl"></div>
    
    <div class="relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold text-[#0F4C5C] mb-4">
            Assalamu'alaikum!
        </h1>
        <p class="text-lg text-[#0F4C5C]/80 mb-8 max-w-md mx-auto">
            Ayo bermain sambil belajar huruf Hijaiyah bersama. MasyaAllah, seru lho!
        </p>
        
        <a 
            href="/hijaiyah/levels" 
            class="inline-flex items-center justify-center bg-[#FFD166] text-[#0F4C5C] font-bold text-lg px-8 py-4 rounded-full shadow-md hover:scale-105 transition-transform hover:shadow-lg active:scale-95"
        >
            Mulai Bermain
            <svg class="w-6 h-6 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
        </a>
    </div>
</div>
