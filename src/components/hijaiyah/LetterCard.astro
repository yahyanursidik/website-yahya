---
interface Props {
    slug: string;
    arabicLetter: string;
    nameLatin: string;
    nameArabic?: string;
    status?: 'learned' | 'review' | 'locked';
    category?: 'normal' | 'litsawiyyah' | 'tafkhim' | 'tafkhim-tarqiq' | 'litsawiyyah-tafkhim';
}

const { slug, arabicLetter, nameLatin, nameArabic, status = 'locked', category = 'normal' } = Astro.props;

// Define styling based on status
const styles = {
    learned: {
        bg: 'bg-[#EAF5F0]',
        text: 'text-[#114D4D]',
        nameText: 'text-[#1B7070]',
        badgeBg: 'bg-[#D6A13B]',
        badgeIcon: `<svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>`
    },
    review: {
        bg: 'bg-[#F1E9D8]',
        text: 'text-[#1C1A17]',
        nameText: 'text-[#5E5545]',
        badgeBg: 'bg-[#FFD1D1]',
        badgeIcon: `<svg class="w-3 h-3 text-[#D92D20]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>`
    },
    locked: {
        bg: 'bg-[#EBE5D9]',
        text: 'text-[#8F9B9B]',
        nameText: 'text-[#8F9B9B]',
        badgeBg: '',
        badgeIcon: ''
    }
};

const currentStyle = styles[status];

let customBg = currentStyle.bg;
let customText = currentStyle.text;
let customNameText = currentStyle.nameText;
let customShadow = 'shadow-[#D6CEC0]/40';

if (category !== 'normal') {
    customText = 'text-[#114D4D]';
    customNameText = 'text-[#1B7070]';
    
    if (category === 'litsawiyyah') {
        customBg = 'bg-[#FFF3B8]';
        customShadow = 'shadow-[#F2D750]/30';
    } else if (category === 'tafkhim') {
        customBg = 'bg-[#CBEFFF]';
        customShadow = 'shadow-[#7ACFFB]/30';
    } else if (category === 'tafkhim-tarqiq') {
        customBg = 'bg-[#FFCCE1]';
        customShadow = 'shadow-[#FFA3CD]/30';
    } else if (category === 'litsawiyyah-tafkhim') {
        customBg = 'bg-gradient-to-b from-[#FFF3B8] to-[#CBEFFF]';
        customShadow = 'shadow-[#9DDDFB]/30';
    }
}
---

<a 
    href={`/hijaiyah/letter/${slug}`}
    data-status={status}
    class={`letter-card relative flex flex-col items-center justify-center rounded-[2.5rem] p-6 shadow-xl ${customShadow} transition-transform hover:-translate-y-1 active:translate-y-0 active:shadow-md mb-2 aspect-[4/5] ${customBg}`}
>
    {status !== 'locked' && category === 'normal' && (
        <div class={`absolute top-4 right-4 w-6 h-6 rounded-full flex items-center justify-center ${currentStyle.badgeBg}`} set:html={currentStyle.badgeIcon} />
    )}
    
    <div class={`text-7xl font-arabic mb-4 mt-6 transition-transform group-hover:scale-105 leading-none ${customText}`}>
        {arabicLetter}
    </div>
    <div class="flex flex-col items-center">
        <div class={`text-xl font-medium ${customNameText}`}>
            {nameLatin}
        </div>
        {nameArabic && (
            <div class="mt-2 text-sm px-4 py-1 rounded-full bg-[#114D4D] text-white font-arabic shadow-sm opacity-90">
                {nameArabic}
            </div>
        )}
    </div>
</a>
