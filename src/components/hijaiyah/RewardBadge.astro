---
interface Props {
    title: string;
    description: string;
    icon: string;
    isEarned: boolean;
}

const { title, description, icon, isEarned } = Astro.props;
---

<div class={`flex flex-col items-center p-4 rounded-2xl border-2 transition-all ${
    isEarned 
    ? 'bg-[#FFD166]/10 border-[#FFD166] opacity-100 scale-100 shadow-sm' 
    : 'bg-gray-50 border-gray-200 opacity-60 scale-95 grayscale'
}`}>
    <div class={`w-16 h-16 rounded-full flex items-center justify-center text-3xl mb-3 ${
        isEarned ? 'bg-[#FFD166] shadow-md text-[#0F4C5C]' : 'bg-gray-200 text-gray-400'
    }`}>
        {icon}
    </div>
    <h4 class={`font-bold text-center text-sm mb-1 ${isEarned ? 'text-[#0F4C5C]' : 'text-gray-500'}`}>
        {title}
    </h4>
    <p class="text-xs text-center text-gray-500">
        {description}
    </p>
</div>
