---
interface Props {
    slug: string;
    levelNumber: number;
    title: string;
    description: string;
    status?: 'completed' | 'in-progress' | 'locked' | 'special';
    progress?: number;
    arabicIcon?: string;
}

const { slug, levelNumber, title, description, status = 'locked', progress = 0, arabicIcon = 'ا' } = Astro.props;

let bgClass = 'bg-white';
let borderClass = 'border-[#114D4D]';
let iconBgClass = 'bg-[#114D4D]';
let iconColorClass = 'text-white';
let titleColor = 'text-[#114D4D]';
let shadowClass = 'shadow-[0px_6px_0px_0px_rgba(17,77,77,0.1)]'; // light shadow mimicking border

if (status === 'in-progress') {
    iconBgClass = 'bg-[#A8DADC]';
    iconColorClass = 'text-[#114D4D]';
} else if (status === 'locked') {
    bgClass = 'bg-[#EBE5D9]';
    borderClass = 'border-[#D1CCC0]';
    iconBgClass = 'bg-transparent';
    titleColor = 'text-[#8F9B9B]';
    shadowClass = 'shadow-[0px_4px_0px_0px_rgba(209,204,192,0.5)]';
} else if (status === 'special') {
    bgClass = 'bg-[#F9D976]';
    borderClass = 'border-[#D6A13B]';
    shadowClass = 'shadow-[0px_6px_0px_0px_rgba(214,161,59,0.3)]';
    titleColor = 'text-[#5E5545]';
}

// Icons mapping matching the design (now using text for letters, but keeping star for bg)
const starIcon = `<svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>`;

const currentIcon = `<span class="font-arabic text-3xl leading-none pt-1">${arabicIcon}</span>`;
const specialIcon = `<span class="font-arabic text-5xl leading-none pt-2">${arabicIcon}</span>`;
---

{status === 'special' ? (
    <a href="#" class={`block relative overflow-hidden rounded-[2.5rem] p-6 sm:p-8 border ${borderClass} ${bgClass} ${shadowClass} transition-transform`}>
        <div class="absolute -right-12 -bottom-16 opacity-30 pointer-events-none">
            <div class="w-64 h-64 rounded-full border-[12px] border-current flex items-center justify-center text-[#B58A24]">
                <svg class="w-40 h-40" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
            </div>
        </div>
        
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-6 relative z-10">
            <div class="w-24 h-24 rounded-full bg-[#B58A24]/60 flex items-center justify-center text-[#5E5545] shrink-0 border-4 border-[#D6A13B]/20">
                <Fragment set:html={specialIcon} />
            </div>
            
            <div class="flex-1 text-center sm:text-left mt-2">
                <h3 class={`text-2xl font-bold mb-2 ${titleColor}`}>
                    Level {levelNumber}: {title}
                </h3>
                <p class={`text-[#5E5545] mb-8 font-medium max-w-md`}>
                    {description}
                </p>
                
                <div class="flex items-center gap-4">
                    <span class="text-sm font-bold text-[#5E5545]/80">Terkunci</span>
                    <div class="flex-1 h-2.5 rounded-full bg-[#D6A13B]/40 relative">
                        <div class="absolute inset-0 flex items-center justify-center">
                            <svg class="w-3 h-3 text-[#5E5545]/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </a>
) : (
    <a 
        href={status === 'locked' ? '#' : `/hijaiyah/level/${slug}`}
        class={`block relative overflow-hidden rounded-[2.5rem] p-6 border transition-transform ${
            status === 'locked' ? 'opacity-100 cursor-not-allowed' : 'hover:-translate-y-1 cursor-pointer'
        } ${borderClass} ${bgClass} ${shadowClass}`}
    >
        {status === 'completed' && (
            <div class="absolute top-0 right-0 w-32 h-32 bg-[#E5F5F3] rounded-bl-full opacity-60 pointer-events-none"></div>
        )}
        
        <div class="relative z-10 flex flex-col items-center">
            {status === 'locked' ? (
                <div class="w-16 h-16 flex items-center justify-center text-[#8F9B9B] mb-4">
                    <Fragment set:html={currentIcon} />
                </div>
            ) : (
                <div class={`w-16 h-16 rounded-full flex items-center justify-center mb-4 ${iconBgClass} ${iconColorClass}`}>
                    <Fragment set:html={currentIcon} />
                </div>
            )}
            
            <h3 class={`text-lg font-bold mb-10 text-center ${titleColor}`}>
                Level {levelNumber}: {title}
            </h3>
            
            <div class="w-full mt-auto">
                {status === 'locked' ? (
                    <div class="flex flex-col items-center">
                        <span class="text-xs font-bold text-[#8F9B9B] mb-2">Belum mulai</span>
                        <div class="w-full h-2 rounded-full bg-[#E0D8C8]"></div>
                    </div>
                ) : (
                    <>
                        <div class="flex justify-between items-end mb-2">
                            <span class={`text-xs font-bold ${status === 'completed' ? 'text-[#114D4D]' : 'text-[#4A90E2]'}`}>
                                {status === 'completed' ? 'Selesai' : 'Lanjutkan'}
                            </span>
                            <span class="text-xs font-bold text-[#114D4D]">{progress}%</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-[#EBE5D9]">
                            <div class="h-2 rounded-full bg-[#D6A13B]" style={`width: ${progress}%`}></div>
                        </div>
                    </>
                )}
            </div>
        </div>
    </a>
)}
